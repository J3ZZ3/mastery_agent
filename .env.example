# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed to call the API with credentials.
# Unsafe requests from any other browser origin are rejected with 403.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
MASTERY_THRESHOLD=80
DEMO_DELAY_MS=450
# Optional absolute directory for db.json, e.g. a mounted Render disk.
# MASTERY_DATA_DIR=

# Classroom tenancy (Postgres). Leave DATABASE_URL empty to run the demo only.
# Start one locally with `docker compose up -d`.
# DATABASE_URL=postgres://mastery:mastery@localhost:5433/mastery
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# SESSION_TTL_DAYS=30
# STUDENT_SESSION_HOURS=12
# SESSION_COOKIE_SECURE=true
# TEACHER_SIGNUP_OPEN=true
# Absolute origin used in emailed links. Defaults to CLIENT_ORIGIN.
# APP_ORIGIN=https://mastery.example
# Set to true to require teachers to verify their email before managing classes.
# REQUIRE_TEACHER_EMAIL_VERIFICATION=false
# Password-reset and verification link lifetimes.
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_VERIFICATION_TTL_HOURS=48

# Teacher account email: "console" (default, prints the link to the server log),
# "resend" (HTTP API) or "disabled".
EMAIL_DELIVERY=console
EMAIL_FROM="MASTERY <no-reply@localhost>"
# RESEND_API_KEY=re_...

# AI provider: "demo" (default) or "openai"
AI_PROVIDER=demo

# Only used when AI_PROVIDER=openai. Never expose this in the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=18000
