# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
MASTERY_THRESHOLD=80
DEMO_DELAY_MS=450

# AI provider: "demo" (default) or "openai"
AI_PROVIDER=demo

# Only used when AI_PROVIDER=openai. Never expose this in the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=18000
