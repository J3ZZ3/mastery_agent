# Server
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed to call the API with credentials.
# Unsafe requests from any other browser origin are rejected with 403.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
MASTERY_THRESHOLD=80
# Optional absolute directory for the JSON store.
# MASTERY_DATA_DIR=

# Classroom tenancy (Postgres). Leave DATABASE_URL empty to use the JSON store.
# Start one locally with `docker compose up -d`.
# DATABASE_URL=postgres://mastery:mastery@localhost:5433/mastery
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
# SESSION_TTL_DAYS=30
# STUDENT_SESSION_HOURS=12
# SESSION_COOKIE_SECURE=true
# TEACHER_SIGNUP_OPEN=true
# Absolute origin used in emailed links. Defaults to CLIENT_ORIGIN.
# APP_ORIGIN=https://mastery.example
# Set to true to require teachers to verify their email before managing classes.
# REQUIRE_TEACHER_EMAIL_VERIFICATION=false
# Password-reset and verification link lifetimes.
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_VERIFICATION_TTL_HOURS=48

# Teacher account email: "console" (default, prints the link to the server log),
# "resend" (HTTP API) or "disabled".
EMAIL_DELIVERY=console
EMAIL_FROM="MASTERY <no-reply@localhost>"
# RESEND_API_KEY=re_...

# AI provider. MASTERY runs on a live model; there is no demo engine and no
# deterministic fallback. Supported values: groq, openai, and test (tests only,
# never in production).
AI_PROVIDER=groq

# Groq (default). Never expose this key in the browser.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# qwen3 32b is a good free-tier default for fast JSON, but its 1000 output
# tokens/minute cap is too small for the intervention JSON. Use
# openai/gpt-oss-120b with a larger GROQ_MAX_TOKENS for the full cycle.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2500
GROQ_TIMEOUT_MS=60000

# Optional OpenAI-compatible endpoint, e.g. OpenAI, Gemini, ollama or llama.cpp.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=60000
# Reasoning models spend part of this budget on internal thinking; keep it
# generous (e.g. 3000) for Gemini/OpenAI reasoning models.
# OPENAI_MAX_TOKENS=3000

# Gemini via its OpenAI-compatible endpoint:
# AI_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-3.5-flash
# OPENAI_TIMEOUT_MS=120000
# OPENAI_MAX_TOKENS=3000
